# --- THE BACKGROUND ---
background {
    monitor =
    path = screenshot
    color = rgba(5, 5, 8, 1.0)
    blur_passes = 3
    blur_size = 8
}

# --- THE CLOCK ---
label {
    monitor =
    text = cmd[update:1000] echo "<b>$(date +"%H:%M:%S")</b>"
    color = rgb(255, 0, 124)
    font_size = 75
    font_family = JetBrainsMono Nerd Font
    position = 0, 80
    halign = center
    valign = center
}

# --- THE PASSWORD FIELD ---
input-field {
    monitor =
    size = 300, 50
    outline_thickness = 2
    dots_size = 0.33
    dots_spacing = 0.15
    dots_center = true
    outer_color = rgb(255, 0, 124)
    inner_color = rgba(5, 5, 8, 0.8)
    font_color = rgb(0, 255, 255)
    fade_on_empty = false
    placeholder_text = <i>System Locked...</i>
    hide_input = false
    position = 0, -50
    halign = center
    valign = center
}
